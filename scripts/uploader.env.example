# RimWorld map uploader config.
# Copy to  ~/.config/rimworld-map/uploader.env  and edit. Loaded by upload-map-screenshot.sh
# (and by the launchd/systemd launchers). Keep UPLOAD_CMD SINGLE-QUOTED so $SRC_FILE (the newest
# PNG, provided per-upload) is expanded at upload time, not now.

# Progress Renderer output folder — edit for your OS/user:
#   macOS:   $HOME/Library/Application Support/RimWorld/RenderProgress
#   Linux:   $HOME/.config/unity3d/Ludeon Studios/RimWorld by Ludeon Studios/RenderProgress
export SRC_DIR="$HOME/Library/Application Support/RimWorld/RenderProgress"

# How often (seconds) to check the folder for a new render:
export INTERVAL=60

# ── Publish the newest PNG to a stable public URL (pick ONE) ────────────────────────────────

# GitHub, dedicated repo, single amended commit (no history bloat). Recommended.
#   one-time setup:
#     gh repo create rimworld-map --public --clone && cd rimworld-map
#     cp any.png latest.png && git add latest.png && git commit -qm map && git push -u origin main
#     gh auth setup-git      # so background `git push` works over HTTPS without SSH agent
#   URL -> https://raw.githubusercontent.com/<you>/rimworld-map/main/latest.png
# IMPORTANT: the dest extension must match Progress Renderer's output format — use latest.jpg if PR
# outputs JPG (raw.githubusercontent sends nosniff, so a .jpg served as .png won't render). `add -A`
# (not -aqm) so a brand-new latest.* gets committed; the diff-guard skips empty commits on restart.
export UPLOAD_CMD='cp "$SRC_FILE" "$HOME/rimworld-map/latest.png" && git -C "$HOME/rimworld-map" add -A && (git -C "$HOME/rimworld-map" diff --cached --quiet || (git -C "$HOME/rimworld-map" commit -qm map --amend && git -C "$HOME/rimworld-map" push -fq))'

# GitHub release asset (no git history; only needs `gh`, most robust headless):
#   gh release create map -R <you>/rimworld-map -t "Colony map" -n auto     # once
#   URL -> https://github.com/<you>/rimworld-map/releases/download/map/latest.png
# export UPLOAD_CMD='cp "$SRC_FILE" /tmp/latest.png && gh release upload map /tmp/latest.png --clobber -R <you>/rimworld-map'

# Cloudflare R2 / S3 / B2 via rclone:
# export UPLOAD_CMD='rclone copyto "$SRC_FILE" r2:rimworld-map/latest.png --header-upload "Cache-Control: public, max-age=60"'

# Your own homelab / server over SSH:
# export UPLOAD_CMD='rsync -a "$SRC_FILE" you@host:/var/www/rimworld/latest.png'

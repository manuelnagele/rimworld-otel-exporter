# Copy to alloy/.env and fill in from your Grafana Cloud stack:
#   Grafana Cloud portal → your stack → "OTLP" → Configuration.
# Then:  export $(grep -v '^#' alloy/.env | xargs) && alloy run alloy/config.alloy

# The OTLP gateway URL for your region (ends in /otlp, NOT /otlp/v1/metrics)
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp

# Your numeric stack/instance id (shown as the OTLP "Instance ID" / username)
GRAFANA_CLOUD_INSTANCE_ID=123456

# An Access Policy token with scopes: metrics:write, logs:write
GRAFANA_CLOUD_API_TOKEN=glc_replace_me

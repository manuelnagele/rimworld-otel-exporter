  "__requires": [],
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "type": "dashboard"
      },
      {
        "name": "Raids & Deaths",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "expr": "{service_name=\"rimworld-colony\"} | run=~\"$run\" | event_type=~\"incident|death\""
        },
        "titleFormat": "{{event_type}}"
      },
      {
        "name": "Mental Breaks",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "expr": "{service_name=\"rimworld-colony\"} | run=~\"$run\" | event_type=~\"mental_break\""
        },
        "titleFormat": "{{event_type}}"
      },
      {
        "name": "Research",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "expr": "{service_name=\"rimworld-colony\"} | run=~\"$run\" | event_type=~\"research\""
        },
        "titleFormat": "{{event_type}}"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
